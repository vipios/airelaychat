<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>中转站</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- 关键：中转站是家里路由器上的纯 HTTP 服务，必须放开 ATS，否则 iOS 一律拦截 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- 局域网访问 192.168.x.x 需要这个描述，iOS 14+ 会弹权限框 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>需要访问你家里路由器上的 AI 中转站，才能聊天。</string>

	<!-- 选照片/视频、拍照 -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>选择照片或视频发给 AI 分析。</string>
	<key>NSCameraUsageDescription</key>
	<string>拍一张照片发给 AI 分析。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>按住说话时需要用麦克风录音，再转成文字发给 AI。</string>
	<!-- 按住说话转文字 -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>把你说的话转成文字，填进输入框。</string>

	<!-- 家里地址上报渠道。
	     真实值不写进源码：仓库是公开的，写死等于把家里的公网地址公开。
	     构建时由 workflow 从 GitHub Secret 注入（GIST_ID / GIST_OWNER）。
	     本地手动构建可以自己填，填了才有「在外自动找地址」的能力。 -->
	<key>AIRelayGistId</key>
	<string>$(GIST_ID)</string>
	<key>AIRelayGistOwner</key>
	<string>$(GIST_OWNER)</string>
	<!-- 固定域名（Cloudflare 隧道）。在外面走 https，不依赖 IPv6 直连。
	     和 Gist 一样从构建变量注入，源码与仓库里都不留真实值。 -->
	<key>AIRelayPublicDomain</key>
	<string>$(PUBLIC_DOMAIN)</string>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<key>UISupportsDocumentBrowser</key>
	<false/>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>
</dict>
</plist>
